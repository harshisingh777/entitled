  "criteria": [
    {
      "id": "woman",
      "logic": {
        "==": [
          {
            "var": "gender"
          },
          "female"
        ]
      },
      "label": {
        "hi": "महिला आवेदक",
        "en": "Woman applicant"
      },
      "fail": {
        "hi": "यह योजना महिलाओं के लिए है",
        "en": "This scheme is for women"
      }
    },
    {
      "id": "age_min_19",
      "logic": {
        ">=": [
          {
            "var": "age"
          },
          19
        ]
      },
      "label": {
        "hi": "उम्र 19+",
        "en": "Age 19+"
      },
      "fail": {
        "hi": "उम्र {age} है, कम से कम 19 चाहिए",
        "en": "Age is {age}, must be at least 19"
      }
    },
    {
      "id": "age_max_50",
      "logic": {
        "<=": [
          {
            "var": "age"
          },
          50
        ]
      },
      "label": {
        "hi": "उम्र 50 तक",
        "en": "Age up to 50"
      },
      "fail": {
        "hi": "उम्र {age} है, 50 तक ही मान्य",
        "en": "Age is {age}, limit is 50"
      }
    },
    {
      "id": "pregnant",
      "logic": {
        "==": [
          {
            "var": "pregnant_or_lactating"
          },
          true
        ]
      },
      "label": {
        "hi": "गर्भवती या स्तनपान",
        "en": "Pregnant or lactating"
      },
      "fail": {
        "hi": "गर्भवती या स्तनपान कराने वाली महिलाओं के लिए है",
        "en": "Only for pregnant or lactating women"
      }
    }
  ],
