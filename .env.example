# Entitled runs with every value below empty. Each key only upgrades one capability.

# Speech (Saaras and Bulbul) and document reading (Sarvam Vision). Empty: browser speech and on-device OCR.
SARVAM_API_KEY=

# Speech fallback through the government Dhruva pipeline.
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Optional fact extraction for messy speech, through any OpenAI-compatible API.
# Empty LLM_API_KEY reuses SARVAM_API_KEY. With neither, the built-in pattern extractor does the job alone.
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_API_KEY=
LLM_MODEL=sarvam-105b
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Real SMS reminders. Empty: reminders stay in the app, labelled as simulated.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Defaults to SQLite under backend/data. A PostgreSQL URL also works if you add a driver such as psycopg.
# DATABASE_URL=postgresql+psycopg://user:password@localhost/entitled

# Deployment only. See DEPLOYMENT.md.
# Signs confirmation tokens. Empty: generated once and kept in the data folder.
# CONFIRMATION_SECRET=
# Holds the database and form screenshots. Point it at a disk that survives restarts.
# ENTITLED_DATA_DIR=/data
# The port the backend listens on. The form agent uses it to reach the portal.
# BACKEND_PORT=8000
# Set on the frontend when it is built, not here: BACKEND_URL=https://your-backend.example.com
