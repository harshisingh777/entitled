    "en": "The registered landholder"
  },
  "criteria": [
    {
      "id": "farmland",
      "logic": {
        "==": [
          {
            "var": "owns_farmland"
          },
          true
        ]
      },
      "label": {
        "hi": "खेती की ज़मीन",
        "en": "Owns farmland"
      },
      "fail": {
        "hi": "परिवार के नाम खेती की ज़मीन नहीं है",
        "en": "No farmland in the family's name"
      }
    },
    {
      "id": "no_tax",
      "logic": {
        "==": [
          {
            "var": "income_tax_payer"
          },
          false
        ]
      },
      "label": {
        "hi": "आयकर दाता नहीं",
        "en": "Not an income-tax payer"
      },
      "fail": {
        "hi": "परिवार में आयकर दाता होने पर यह नहीं मिलती",
        "en": "Not available if the family pays income tax"
      }
    },
    {
      "id": "no_govt",
      "logic": {
        "==": [
          {
            "var": "govt_employee"
          },
          false
        ]
      },
      "label": {
        "hi": "सरकारी कर्मचारी नहीं",
        "en": "No government employee"
      },
      "fail": {
        "hi": "परिवार में सरकारी कर्मचारी होने पर यह नहीं मिलती",
        "en": "Not available with a government employee in the family"
      }
    }
  ],
